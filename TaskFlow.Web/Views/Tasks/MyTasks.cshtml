@model List<TaskFlow.Web.Models.TaskItemViewModel>

@{
    ViewData["Title"] = "Görevlerim";
}

<div class="container mt-4">

    <h2 class="mb-4">Görevlerim</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }



    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Size atanmış bir görev bulunmuyor.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var task in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4 class="card-title">
                                @task.Title
                            </h4>

                            <p class="card-text">
                                @task.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Öncelik:</strong>
                                @task.Priority
                            </p>

                            <p>
                                <strong>Durum:</strong>

                                @if (task.StatusId == 1)
                                {
                                    <span class="badge bg-secondary">
                                        Bekliyor
                                    </span>
                                }
                                else if (task.StatusId == 2)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Devam Ediyor
                                    </span>
                                }
                                else if (task.StatusId == 3)
                                {
                                    <span class="badge bg-success">
                                        Tamamlandı
                                    </span>
                                }
                            </p>

                            <form asp-controller="Tasks"
                                  asp-action="UpdateStatus"
                                  method="post"
                                  class="mt-3">

                                <input type="hidden"
                                       name="taskId"
                                       value="@task.Id" />

                                <div class="mb-2">
                                    <label class="form-label">
                                        <strong>Görev Durumunu Değiştir</strong>
                                    </label>

                                    <select name="statusId"
                                            class="form-select">

                                        <option value="1"
                                                selected="@(task.StatusId == 1)">
                                            Bekliyor
                                        </option>

                                        <option value="2"
                                                selected="@(task.StatusId == 2)">
                                            Devam Ediyor
                                        </option>

                                        <option value="3"
                                                selected="@(task.StatusId == 3)">
                                            Tamamlandı
                                        </option>

                                    </select>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Durumu Güncelle
                                </button>

                            </form>


                            @if (task.DueDate != null)
                            {
                                <p>
                                    <strong>Son Tarih:</strong>
                                    @task.DueDate.Value.ToString("dd.MM.yyyy")
                                </p>
                            }

                        </div>

                    </div>
                </div>
            }

        </div>
    }

</div>
