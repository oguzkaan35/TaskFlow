@model TaskFlow.Web.Models.AssignTaskViewModel

@{
    ViewData["Title"] = "Görev Ata";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-4">Yeni Görev Ata</h2>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-controller="Admin"
                          asp-action="AssignTask"
                          method="post">

                        <div class="mb-3">
                            <label asp-for="Title"
                                   class="form-label">
                                Görev Başlığı
                            </label>

                            <input asp-for="Title"
                                   class="form-control" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>
                        </div>





                        <div class="mb-3">

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>


                            <label asp-for="Description"
                                   class="form-label">
                                Açıklama
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3">
                            </textarea>
                        </div>






                        <div class="mb-3">


                            <span asp-validation-for="AssignedUserId"
                                  class="text-danger">
                            </span>


                            <label asp-for="AssignedUserId"
                                   class="form-label">
                                Kullanıcı
                            </label>

                            <select asp-for="AssignedUserId"
                                    asp-items="Model.Users"
                                    class="form-select">

                                <option value="0">
                                    Kullanıcı seçiniz
                                </option>

                            </select>
                        </div>





                        <div class="mb-3">


                            <span asp-validation-for="ProjectId"
                                  class="text-danger">
                            </span>


                            <label asp-for="ProjectId"
                                   class="form-label">
                                Proje
                            </label>

                            <select asp-for="ProjectId"
                                    asp-items="Model.Projects"
                                    class="form-select">

                                <option value="0">
                                    Proje seçiniz
                                </option>

                            </select>
                        </div>






                        <div class="mb-3">
                            <label asp-for="Priority"
                                   class="form-label">
                                Öncelik
                            </label>

                            <select asp-for="Priority"
                                    class="form-select">

                                <option value="Düşük">Düşük</option>
                                <option value="Orta">Orta</option>
                                <option value="Yüksek">Yüksek</option>

                            </select>
                        </div>






                        <div class="mb-3">
                            <label asp-for="DueDate"
                                   class="form-label">
                                Son Tarih
                            </label>

                            <input asp-for="DueDate"
                                   type="date"
                                   class="form-control" />
                        </div>





                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">
                                Görevi Ata
                            </button>

                            <a asp-controller="Admin"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Geri Dön
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>