@model List<TaskFlow.Web.Models.TaskItemViewModel>

@{
    ViewData["Title"] = "Tüm Görevler";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Tüm Görevler</h2>
            <p class="text-muted">
                Sistemdeki bütün görevleri buradan görüntüleyebilirsiniz.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Admin Paneline Dön
        </a>

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Sistemde görev bulunmuyor.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Görev</th>
                            <th>Atanan Kullanıcı</th>
                            <th>Proje</th>
                            <th>Öncelik</th>
                            <th>Durum</th>
                            <th>Son Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var task in Model)
                        {
                            <tr>
                                <td>@task.Id</td>

                                <td>
                                    <strong>@task.Title</strong>
                                </td>

                                <td>@task.AssignedUserName</td>

                                <td>@task.ProjectName</td>

                                <td>@task.Priority</td>

                                <td>
                                    @if (task.StatusId == 1)
                                    {
                                        <span class="badge bg-secondary">
                                            Bekliyor
                                        </span>
                                    }
                                    else if (task.StatusId == 2)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Devam Ediyor
                                        </span>
                                    }
                                    else if (task.StatusId == 3)
                                    {
                                        <span class="badge bg-success">
                                            Tamamlandı
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(task.DueDate?.ToString("dd.MM.yyyy") ?? "-")
                                </td>




                                <td>
                                    <a asp-controller="Admin"
                                       asp-action="EditTask"
                                       asp-route-id="@task.Id"
                                       class="btn btn-warning btn-sm">
                                        Düzenle
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="DeleteTask"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@task.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Bu görevi silmek istediğinize emin misiniz?');">
                                            Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                         }       

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>
