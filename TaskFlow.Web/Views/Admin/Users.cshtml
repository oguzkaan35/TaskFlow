@model List<TaskFlow.Web.Models.UserListViewModel>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }


        <div>
            <h2>Kullanıcılar</h2>
            <p class="text-muted">
                Sistemde kayıtlı kullanıcıları görüntüleyebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Admin"
               asp-action="CreateUser"
               class="btn btn-success">
                + Yeni Kullanıcı
            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-secondary">
                Admin Paneline Dön
            </a>

        </div>

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Sistemde kayıtlı kullanıcı bulunmuyor.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Ad Soyad</th>
                            <th>Kullanıcı Adı</th>
                            <th>Rol</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.FullName</td>
                                <td>@user.Username</td>

                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            User
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Admin"
                                       asp-action="EditUser"
                                       asp-route-id="@user.Id"
                                       class="btn btn-warning btn-sm">
                                        Düzenle
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="DeleteUser"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@user.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');">
                                            Sil
                                        </button>

                                    </form>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>